rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Bootstrapped Admin: Only verified owner email is permitted admin privileges
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email in ['ashishnaik1386@gmail.com', 'starlineadventure@gmail.com', 'starlineadventuresales@gmail.com']
        && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Enquiry validation
    function isValidEnquiry(data) {
      return data.keys().hasAll(['id', 'formType', 'name', 'email', 'phone', 'message', 'createdAt'])
        && data.keys().hasOnly(['id', 'formType', 'name', 'email', 'phone', 'company', 'location', 'product', 'message', 'createdAt', 'status'])
        && data.id is string && data.id.size() <= 128
        && data.formType is string && data.formType.size() <= 64
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() > 0 && data.email.size() <= 120
        && data.phone is string && data.phone.size() > 0 && data.phone.size() <= 30
        && data.message is string && data.message.size() > 0 && data.message.size() <= 2000
        && ((data.createdAt is timestamp && data.createdAt == request.time) || (data.createdAt is string && data.createdAt.size() <= 64))
        && (!('location' in data) || (data.location is string && data.location.size() <= 120))
        && (!('product' in data) || (data.product is string && data.product.size() <= 120))
        && (!('company' in data) || (data.company is string && data.company.size() <= 120))
        && (!('status' in data) || (data.status is string && data.status.size() <= 30));
    }

    // Testimonial validation
    function isValidTestimonial(data) {
      return data.keys().hasAll(['id', 'name', 'rating', 'comment', 'createdAt'])
        && data.keys().hasOnly(['id', 'name', 'company', 'location', 'rating', 'comment', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && (data.rating is number || data.rating is int) && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() > 0 && data.comment.size() <= 1000
        && data.createdAt is string && data.createdAt.size() <= 64
        && (!('company' in data) || (data.company is string && data.company.size() <= 120))
        && (!('location' in data) || (data.location is string && data.location.size() <= 100));
    }

    // User validation
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt'])
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 120
        && data.createdAt is string && data.createdAt.size() <= 64
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500));
    }

    // Safe connection test path - only single document get allowed for health probes, write strictly blocked
    match /test/{testId} {
      allow get: if true;
      allow list, write: if false;
    }

    // Enquiries collection rules - Customer records must NOT be publicly readable.
    // Unauthenticated or standard users cannot read, list, update, or delete enquiry records.
    match /enquiries/{enquiryId} {
      allow create: if isValidId(enquiryId) && isValidEnquiry(incoming());
      allow get, list, update, delete: if isAdmin();
    }

    // Testimonials collection rules - Public read, verified schema creation, admin maintenance
    match /testimonials/{testimonialId} {
      allow get, list: if true;
      allow create: if isValidId(testimonialId) && isValidTestimonial(incoming());
      allow update, delete: if isAdmin();
    }

    // Users collection rules - Protected to owner and admin
    match /users/{userId} {
      allow get, create, update: if (isOwner(userId) || isAdmin()) && isValidUser(incoming());
      allow list, delete: if isAdmin();
    }
  }
}
