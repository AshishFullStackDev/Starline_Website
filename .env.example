# Server Configuration
PORT=3000
NODE_ENV=production

# Gmail SMTP Configuration for Starline Adventures
EMAIL_USER=starlineadventure@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password_here

# Admin Authentication Secret for API management
ADMIN_SECRET=your_admin_secret_key_here

# Optional: Comma-separated allowed CORS origins in production
ALLOWED_ORIGINS=https://starlineadventures.com,https://www.starlineadventures.com

