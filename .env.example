# Environment mode: 'production' or 'development'
NODE_ENV=production

# Email Notification Credentials (Google App Password for starlineadventure@gmail.com)
# Generated at https://myaccount.google.com/apppasswords
# For Cloud Functions deployment:
#   firebase functions:secrets:set EMAIL_APP_PASSWORD
# For server execution:
